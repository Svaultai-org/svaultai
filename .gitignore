.metadata

# IDE
.idea/
.vscode/
# IntelliJ/Android Studio per-module project files. Belongs in the
# per-developer .idea/ config, not tracked. Older checkouts had
# `vault_ai_frontend/vault_ai_frontend.iml` at the module root; this
# pattern keeps it out for good.
*.iml

# Platform-specific
android/.gradle/
ios/Pods/

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# venv
.venv/
.venv
venv/
env/

# Node
node_modules/
node_modules
npm-debug.log
yarn-error.log

# Secrets
.env
.env.*
!.env.example
!.env.production.example
!**/.env.example
!**/.env.production.example
*.key
*.pem



# Build
dist/
build/
*.egg-info/

# Flutter tool cache
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# Flutter Web release output (produced by scripts/build-web-release.sh)
vault_ai_frontend/build/

# Rust build artefacts (opaque_server_crate is built inside Docker,
# never checked in as a compiled binary)
**/target/
**/*.rs.bk

# pytest / mypy caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Flutter test JSON reporter dumps
flutter_full_run*.json
flutter_test_report*.json

# Backend session/ephemeral tool-results (from local shell captures)
tool-results/

# Archives — never commit tarballs / zips of the working tree
*.tar.gz
*.tgz
*.zip

# Logs
*.log

# Local DB artefacts
*.db
*.sqlite
*.sqlite3