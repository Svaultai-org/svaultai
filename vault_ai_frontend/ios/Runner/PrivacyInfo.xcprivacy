<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Privacy Manifest for SVaultAI. Required by Apple since May 2024.
	Uploads without this file are rejected with ITMS-91053 /
	ITMS-91056 for touching "required-reason APIs" (UserDefaults,
	file timestamp, disk space, boot time).

	Declarations must match reality:
	  * NSPrivacyTracking = false — SVaultAI does NOT track users
	    across other apps or websites. No ad SDKs are linked.
	  * NSPrivacyTrackingDomains empty for the same reason.
	  * NSPrivacyCollectedDataTypes lists what the backend receives.
	    Vault payloads remain encrypted in the ZK model, but storage is
	    scoped to an authenticated vault, so user content is conservatively
	    declared as linked to the account.
	  * NSPrivacyAccessedAPITypes declares each required-reason API
	    with an approved reason string per Apple's list.
-->
<plist version="1.0">
<dict>

	<key>NSPrivacyTracking</key>
	<false/>

	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!--
		Data SVaultAI's backend receives directly from the app.
		Encrypted vault payloads are NOT included here because the
		server sees only ciphertext + non-identifying metadata.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>

		<!-- User ID — the user-chosen vault name is an account-level
		     sign-in identifier. It is not required to be an email
		     address and is not used for tracking. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Other User Content — vault payloads such as files, notes,
		     and chat. Stored ciphertext remains scoped to the signed-in
		     vault, so this is conservatively declared as linked while
		     remaining not used for tracking. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Diagnostics — crash logs uploaded via App Store Connect
		     when the user opts in. Non-identifying. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

	</array>

	<!--
		Required-Reason APIs. Every entry below is triggered by a
		plugin we ship. `CA92.1` and `C617.1` cover the "app
		functionality" bucket for UserDefaults and file timestamps
		respectively — the common Flutter / shared_preferences /
		file_picker use.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>

		<!-- shared_preferences → NSUserDefaults -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>

		<!-- file_picker + record → NSFileManager creationDate /
		     modificationDate on temp files -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>

		<!-- Disk-space check used by upload flow to warn before
		     large downloads / recordings -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>

	</array>

</dict>
</plist>
