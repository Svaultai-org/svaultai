<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Svaultai</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>Svaultai</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<!--
		Runtime permission usage descriptions. Every native API that
		requires user consent MUST declare a purpose string here or
		the first call crashes at runtime and App Review rejects
		the submission. Keep these accurate — Apple compares the
		strings to the app's actual behavior.
	-->
		<key>NSCameraUsageDescription</key>
		<string>Svaultai uses the camera to capture photos and videos you choose to save in your private vault and to scan recipient QR codes.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>Svaultai uses the microphone to record voice notes and videos you choose to save in your private vault.</string>
		<key>NSSpeechRecognitionUsageDescription</key>
		<string>Svaultai converts your dictation to text on-device so you can talk to Svaultai Chat without typing.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Svaultai accesses your photo library only when you choose media to save in your private vault.</string>
		<!--
		App Transport Security. Left as system default (HTTPS-only,
		strict TLS). No exception domains — the mobile production
		backend at https://api.svaultai.com serves TLS 1.2+.
	-->
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
