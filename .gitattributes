# 2026-07-14 (Round 12): enforce line endings for executable /
# shell-hosted files so Windows-hosted commits do not check in
# CRLF that breaks Linux `#!` shebang parsing (observed in
# production: `/usr/bin/env: 'bash\r': No such file or directory`
# when running scripts/build-web-release.sh on the release host).
#
# Text-file line endings:
#   * .sh / .bash                                → LF (executable)
#   * .py                                        → LF
#   * .yaml / .yml                               → LF (compat)
#   * .conf                                      → LF (nginx / systemd)
#   * .js                                        → LF (Node / browser)
#   * .dart / .html / .css / .json / .md / .txt  → LF
#   * .ps1                                       → CRLF (Windows-hosted)
#   * everything else                            → git's default handling
#
# Binary/opaque:
#   * .png / .jpg / .jpeg / .gif / .ico / .webp
#   * .tar / .tar.gz / .tgz / .zip / .xz / .7z
#   * .otf / .ttf / .woff / .woff2
#   * .wasm

*.sh        text eol=lf
*.bash      text eol=lf
*.py        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.conf      text eol=lf
*.js        text eol=lf
*.dart      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf

*.ps1       text eol=crlf

*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.tar       binary
*.tar.gz    binary
*.tgz       binary
*.zip       binary
*.xz        binary
*.7z        binary
*.otf       binary
*.ttf       binary
*.woff      binary
*.woff2     binary
*.wasm      binary
