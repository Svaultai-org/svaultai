# VaultAI backend — example environment file for PRODUCTION.
#
# Every value here is a placeholder. Copy to a secret store (Doppler,
# 1Password, AWS Secrets Manager, etc.) and inject at deploy time.
# Never commit real production secrets.
#
# In production, missing required config is a HARD BOOT ERROR — the
# app refuses to start rather than run insecurely.
#
# Dev-oriented example lives at `.env.example`.

# ---- Core -----------------------------------------------------
# MUST be `production` (or `prod`/`live`) in production.
VAULTAI_ENV=production

# Postgres connection string. Use a pooler and enforce SSL.
DATABASE_URL=

# 48-byte URL-safe base64 secret used to HMAC session tokens.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ROTATION invalidates every issued session.
VAULT_SESSION_SECRET=

# Optional separate 32-byte-or-longer secret for keyed OPAQUE auth log
# correlation. Leave blank to suppress identifier fingerprints in logs.
# Do not reuse VAULT_SESSION_SECRET.
VAULTAI_ZK_AUTH_LOG_HMAC_KEY=

# LLM provider. Rotate via the secret store, never in this file.
OPENAI_API_KEY=

# Descope project id.
DESCOPE_PROJECT_ID=


# ---- Production hardening flags -------------------------------
# MUST be `false` (or unset) in prod. `true` refuses to boot.
VAULTAI_DEBUG_ENDPOINTS_ENABLED=false

# MUST be `false` in prod. The dev auto-trust shortcut is an
# emergency lever only, not a production knob.
VAULTAI_DEVICE_GATE_DEV_AUTO_TRUST=false

VAULTAI_EXPERIMENTAL_VAULT_BRAIN_CHAT_ENABLED=false


# ---- CORS / origins -------------------------------------------
# REQUIRED in production. Anchor with ^$ and enumerate every
# legitimate frontend origin. Refuses to boot without this set.
#
# svaultai.com production plan:
#   https://app.svaultai.com   — user-facing web app
#   https://www.svaultai.com   — marketing site
#   https://svaultai.com       — apex, redirects to www
CORS_ALLOWED_ORIGIN_REGEX=^https://(app|www)\.svaultai\.com$|^https://svaultai\.com$

# Comma-separated exact origins used for safe redirect construction.
VAULTAI_ALLOWED_REDIRECT_ORIGINS=https://app.svaultai.com,https://www.svaultai.com,https://svaultai.com

FRONTEND_BASE_URL=https://app.svaultai.com
ALLOWED_ORIGINS=https://app.svaultai.com,https://www.svaultai.com,https://svaultai.com


# ---- Rate limiting --------------------------------------------
RATE_LIMIT_ENABLED=true

# In prod, run the Redis backend so per-node counters cluster.
VAULTAI_RATE_LIMIT_BACKEND=redis
VAULTAI_RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_URL=

# Per-bucket quotas. Blank = code defaults. Tune in the secret
# store once the production baseline is known.
VAULTAI_RL_PIN_VERIFY_LIMIT=
VAULTAI_RL_CHAT_LIMIT=
VAULTAI_RL_DELETE_VAULT_LIMIT=
VAULTAI_RL_UPLOAD_BURST_LIMIT=
VAULTAI_RL_DELETE_BURST_LIMIT=
VAULTAI_RL_EXPORT_LIMIT=


# ---- Security headers -----------------------------------------
# MUST be true in prod. Adds CSP, HSTS, X-Content-Type-Options,
# Referrer-Policy, Permissions-Policy, and no-store on sensitive
# routes.
VAULTAI_SECURITY_HEADERS_ENABLED=true


# ---- Upload / body limits -------------------------------------
# Blank = the defaults baked into main.py. Only override for
# targeted production tuning.
MAX_JSON_BODY_BYTES=
MAX_UPLOAD_BYTES=


# ---- File scan / mass-action guardrails -----------------------
FILE_SCAN_ENABLED=true
FILE_SCAN_PROVIDER=
MASS_ACTION_PROTECTION_ENABLED=true


# ---- Inactive unpaid cleanup ----------------------------------
# ON in prod. Deletes unpaid vaults inactive past the threshold.
INACTIVE_UNPAID_DELETE_ENABLED=true
INACTIVE_UNPAID_DELETE_DAYS=183


# ---- Billing providers ----------------------------------------
# Paid storage is verified by Apple App Store and Google Play only.
# Google Play Billing. Hostinger calls the narrow Cloud Run bridge over HTTPS;
# Cloud Run uses its attached service account through keyless ADC. This shared
# HMAC value comes from each platform's secret store and must be 32+ characters.
# Never set GOOGLE_APPLICATION_CREDENTIALS or create a service-account key.
VAULTAI_GOOGLE_PLAY_BRIDGE_URL=
VAULTAI_GOOGLE_PLAY_BRIDGE_HMAC_SECRET=
VAULTAI_GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=svaultai-play-billing@svaultai-production.iam.gserviceaccount.com
VAULTAI_GOOGLE_PLAY_PACKAGE_NAME=com.svaultai.app
VAULTAI_GOOGLE_PLAY_RTDN_AUDIENCE=https://api.svaultai.com/billing/google-play/rtdn
VAULTAI_GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=svaultai-play-rtdn-push@svaultai-production.iam.gserviceaccount.com
VAULTAI_GOOGLE_PLAY_ALLOW_TEST_PURCHASES=false

# Apple shared backend. The proposed product identifier below may be used only
# after confirming no existing App Store Connect product ID. Store current
# Apple PKI root .cer files outside Git in VAULTAI_APPLE_ROOT_CERT_DIR.
VAULTAI_APPLE_BUNDLE_ID=com.svaultai.app
VAULTAI_APPLE_APP_ID=
VAULTAI_APPLE_ROOT_CERT_DIR=
# Exact current iOS products plus legacy products retained for verified restores.
# Keep this identical to config/apple-storage-products.json; run scripts/verify_apple_billing.py before release.
VAULTAI_APPLE_PRODUCT_MAP_JSON={"svaultai.storage.50gb.monthly":{"quantity":1,"entitlement_bytes":53687091200,"plan_id":"monthly","billing_period":"P1M"},"svaultai.storage.100gb.monthly":{"quantity":2,"entitlement_bytes":107374182400,"plan_id":"monthly","billing_period":"P1M"},"svaultai.storage.150gb.monthly":{"quantity":3,"entitlement_bytes":161061273600,"plan_id":"monthly","billing_period":"P1M"},"svaultai.storage.200gb.monthly":{"quantity":4,"entitlement_bytes":214748364800,"plan_id":"monthly","billing_period":"P1M"},"svaultai.storage.250gb.monthly":{"quantity":5,"entitlement_bytes":268435456000,"plan_id":"monthly","billing_period":"P1M"},"svaultai.storage.300gb.monthly":{"quantity":6,"entitlement_bytes":322122547200,"plan_id":"monthly","billing_period":"P1M"},"svaultai.storage.500gb.monthly":{"quantity":10,"entitlement_bytes":536870912000,"plan_id":"monthly","billing_period":"P1M"},"svaultai.storage.1tb.monthly":{"quantity":20,"entitlement_bytes":1073741824000,"plan_id":"monthly","billing_period":"P1M"},"com.svaultai.app.storage.50gb.monthly.v2":{"quantity":1,"entitlement_bytes":53687091200,"plan_id":"monthly","billing_period":"P1M"},"com.svaultai.app.storage.100gb.monthly.v2":{"quantity":2,"entitlement_bytes":107374182400,"plan_id":"monthly","billing_period":"P1M"},"com.svaultai.app.storage.150gb.monthly.v2":{"quantity":3,"entitlement_bytes":161061273600,"plan_id":"monthly","billing_period":"P1M"},"com.svaultai.app.storage.200gb.monthly.v2":{"quantity":4,"entitlement_bytes":214748364800,"plan_id":"monthly","billing_period":"P1M"},"com.svaultai.app.storage.250gb.monthly.v2":{"quantity":5,"entitlement_bytes":268435456000,"plan_id":"monthly","billing_period":"P1M"},"com.svaultai.app.storage.500gb.monthly.v2":{"quantity":10,"entitlement_bytes":536870912000,"plan_id":"monthly","billing_period":"P1M"},"com.svaultai.app.storage.1tb.monthly.v2":{"quantity":20,"entitlement_bytes":1073741824000,"plan_id":"monthly","billing_period":"P1M"},"com.svaultai.app.storage.2tb.monthly.v2":{"quantity":40,"entitlement_bytes":2147483648000,"plan_id":"monthly","billing_period":"P1M"},"com.svaultai.app.storage.5tb.monthly.v2":{"quantity":100,"entitlement_bytes":5368709120000,"plan_id":"monthly","billing_period":"P1M"}}
VAULTAI_APPLE_ACCEPT_SANDBOX=false



# ---- Crypto Wallet Engine -------------------------------------
VAULTAI_CRYPTO_WALLET_ENGINE_ENABLED=true
VAULTAI_CRYPTO_DEFAULT_NETWORK=ethereum_mainnet

# Ethereum mainnet. RPC URL + indexer API key from secret store.
VAULTAI_CRYPTO_ETH_MAINNET_RECEIVE_ENABLED=true
VAULTAI_CRYPTO_ETH_MAINNET_ERC20_RECEIVE_ENABLED=true
# Mainnet is the production-intended read/receive network. Broadcasting
# remains fail-closed until a separate operator-controlled launch decision.
VAULTAI_CRYPTO_ETH_MAINNET_SEND_ENABLED=false
VAULTAI_CRYPTO_MAINNET_SEND_PAUSED=true
ETHEREUM_MAINNET_RPC_URL=
# Public constants — safe to include.
ETHEREUM_MAINNET_USDT_CONTRACT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7
ETHEREUM_MAINNET_USDC_CONTRACT_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
ETHEREUM_MAINNET_TX_INDEXER_PROVIDER=etherscan
ETHEREUM_MAINNET_TX_INDEXER_API_KEY=

# Solana mainnet.
VAULTAI_CRYPTO_SOLANA_ENABLED=true
VAULTAI_CRYPTO_SOLANA_SEND_ENABLED=true
VAULTAI_CRYPTO_SOLANA_SEND_PAUSED=false
SOLANA_RPC_URL=
SOLANA_TX_INDEXER_PROVIDER=helius
SOLANA_TX_INDEXER_API_KEY=

# TRON mainnet.
VAULTAI_CRYPTO_TRON_ENABLED=true
VAULTAI_CRYPTO_TRON_SEND_ENABLED=true
VAULTAI_CRYPTO_TRON_SEND_PAUSED=false
TRON_API_BASE_URL=
TRON_API_KEY=
# Public constants — safe to include.
TRON_USDT_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_USDT_DECIMALS=6

# Monero. Scanner + send OFF at production launch until we ship
# the resident scanner and audited send path.
VAULTAI_CRYPTO_XMR_ENABLED=false
VAULTAI_CRYPTO_XMR_SEND_ENABLED=false
VAULTAI_CRYPTO_XMR_SCANNER_MODE=none


# ---- Admin health tokens --------------------------------------
# Random 256-bit tokens gate the ops-only health endpoints.
# Placeholder only — inject the real tokens from the secret store.
VAULTAI_CRYPTO_HEALTH_ADMIN_TOKEN=
VAULTAI_BILLING_HEALTH_ADMIN_TOKEN=

# ---- ZK v2 migration infrastructure --------------------------
# Production-safe defaults. Enabling requires a separately reviewed rollout.
ZK_V2_READ_ENABLED=true
ZK_V2_WRITE_ENABLED=false
ZK_V2_MIGRATION_ENABLED=false

MEMORY_V2_READ_ENABLED=true
MEMORY_V2_WRITE_ENABLED=true
MEMORY_V2_MIGRATION_ENABLED=false

FILE_V2_READ_ENABLED=true
FILE_V2_WRITE_ENABLED=true
FILE_V2_MIGRATION_ENABLED=false

WALLET_BACKUP_V2_READ_ENABLED=false
WALLET_BACKUP_V2_WRITE_ENABLED=false
WALLET_BACKUP_V2_MIGRATION_ENABLED=false

WALLET_V2_READ_ENABLED=false
WALLET_V2_WRITE_ENABLED=false
WALLET_V2_MIGRATION_ENABLED=false
# Permit source-bound pending owner copies while old wallet writes remain on.
# Requires WALLET_V2_READ_ENABLED; cannot retire an old wallet by itself.
WALLET_V2_PREPARE_ENABLED=false

PRIVATE_VAULT_LOCAL_ROUTING_ENABLED=false

# ---- OPAQUE-only PIN cutover (all OFF until client/data migration) ----
# Do not enable verifier-free registration while chat, files, legacy records,
# or other active routes still require a server PIN-derived key. Existing
# PIN-encrypted ciphertext is itself an offline guess oracle until moved to
# random MVK-derived encryption; blanking pin_verifier alone is insufficient.
VAULTAI_ZK_VERIFIER_FREE_REGISTRATION_ENABLED=false
VAULTAI_ZK_LEGACY_LOGIN_DISABLED=false
# Separate, default-off server cutover: reject legacy raw-PIN requests for
# OPAQUE vaults after web/iOS/Android and data migration are verified.
# Legacy-only vaults retain their PIN routes. The client-held OPAQUE proof
# and ciphertext migration endpoints remain available without a raw PIN.
VAULTAI_ZK_RAW_PIN_CONTENT_DISABLED=false
# First cutover step: reject only pre-OPAQUE /auth/login before reading its
# body. Current OPAQUE login and all content routes remain available.
VAULTAI_LEGACY_PIN_LOGIN_DISABLED=false
# Broader cutover: reject all inventoried legacy PIN-capable routes before
# reading their bodies, while leaving current OPAQUE login finalize available.
# This can interrupt older content, chat, file, and mobile clients.
VAULTAI_LEGACY_PIN_ROUTES_DISABLED=false
# Final, global strict ingress cutover. When enabled, all 64 inventoried old
# PIN-capable method/path routes are rejected before the API reads their body,
# including /auth/login for legacy-only accounts and older mobile clients.
# The same flag requires X-SVaultAI-Strict-Pin-Free-Client: v1 on OPAQUE login
# finalize before slot consumption or session supersession. The header only
# signals client compatibility; it never authorizes a sensitive action.
# Keep off until private replacements, migrations, and store releases are ready.
VAULTAI_STRICT_RAW_PIN_INGRESS_ENABLED=false
# Irreversible, per-vault verifier retirement. Requires global strict ingress,
# a full server-signed private offer, a recent OPAQUE proof, and zero known
# legacy PIN oracles after owner exact readback. Keep off until parity and
# migrations are independently verified; the old verifier is not backed up
# as a rollback shortcut after this action.
VAULTAI_ZK_PIN_VERIFIER_RETIRE_ENABLED=false
VAULTAI_ZK_DELETE_PROOF_ENABLED=false
# Pending-device self-approval uses a separate device-bound OPAQUE proof.
VAULTAI_ZK_PENDING_DEVICE_PROOF_ENABLED=false
# Trusted ZK sessions can list only structural/encrypted metadata without PIN.
VAULTAI_ZK_METADATA_INVENTORY_ENABLED=false
# PIN-only beneficiary list/transfer checks may accept one-time OPAQUE proof.
# Legacy create/link/claim still need a client-held V2 inheritance protocol.
VAULTAI_ZK_BENEFICIARY_PROOF_ENABLED=false
# Client-encrypted beneficiary pairing and local-only general chat stay off
# until their matching web/iOS/Android clients are released and verified.
VAULTAI_ZK_BENEFICIARY_V2_PAIRING_ENABLED=false
# Released V2 owner files remain encrypted; this read path is separately
# gated until recipient import and all-content inheritance parity are ready.
VAULTAI_ZK_BENEFICIARY_V2_FILE_EXPORT_ENABLED=false
VAULTAI_ZK_LEGACY_BENEFICIARY_UPGRADE_ENABLED=false
# Owner-only staging for already-linked old inheritance. It does not switch
# or release the link and remains off until coordinated client validation.
VAULTAI_ZK_LINKED_BENEFICIARY_V2_STAGE_ENABLED=false
# Beneficiary key possession check releases no owner key or old link access.
# It is not a claim/freeze cutover and requires the stage gate above.
VAULTAI_ZK_LINKED_BENEFICIARY_KEYCHECK_ENABLED=false
# A staged old-link V2 envelope may be read only after the existing owner
# approval or completed cooldown and beneficiary key check. The old package
# stays active; this is not the final old-PIN retirement switch.
VAULTAI_ZK_LINKED_BENEFICIARY_RELEASE_READBACK_ENABLED=false
# A separate owner public verifier and beneficiary signed readback receipt.
# Requires the stage/keycheck/release flags. It does not retire old PIN paths.
VAULTAI_ZK_LINKED_BENEFICIARY_READBACK_PROOF_ENABLED=false
# Bounded, ciphertext-only saved-item copy after the verified readback receipt.
# Requires all linked V2 flags and leaves owner data and legacy routes intact.
VAULTAI_ZK_LINKED_BENEFICIARY_ITEM_IMPORT_ENABLED=false
VAULTAI_ZK_LINKED_BENEFICIARY_ITEM_RESTART_ENABLED=false
VAULTAI_ZK_GENERAL_CHAT_ENABLED=false
# Read-only, OPAQUE proof-gated legacy ciphertext export for client migration.
VAULTAI_ZK_LEGACY_EXPORT_ENABLED=false
# Owner-only, additive older Memory V2 preparation. This leaves the active
# legacy rows intact and does not make the signed Memory offer ready.
VAULTAI_ZK_LEGACY_MEMORY_COPY_ENABLED=false
# Old server-known folder paths may enter an owner-only signed inventory only
# with a matching client capability. Mixed ready-V2 vaults remain ineligible.
VAULTAI_ZK_SIGNED_FOLDER_METADATA_ENABLED=false
# New session-offer format. Enable only after every API instance parses v3
# bearers and matching capable clients are released.
VAULTAI_SIGNED_READ_OFFERS_ENABLED=false
# Separate V2-writer offer for new uploads; pending legacy finalize/abort stay.
VAULTAI_SIGNED_FILE_CREATE_ENABLED=false
# Signed, PIN-free file rename/delete offer for capable private clients.
VAULTAI_SIGNED_FILE_MUTATION_ENABLED=false
VAULTAI_SIGNED_PASSWORD_ANALYSIS_ENABLED=false
VAULTAI_SIGNED_BENEFICIARY_OFFER_ENABLED=false
VAULTAI_SIGNED_AUTH_DEVICE_OFFER_ENABLED=false
VAULTAI_SIGNED_PRIVATE_CHAT_ENABLED=false
# Stage/readback preserves the old PIN ciphertext. Retirement permanently
# removes it only after client exact-content verification and recent OPAQUE.
VAULTAI_ZK_LEGACY_MIGRATION_STAGE_ENABLED=false
# Enables owner-only plaintext legacy text/path export and version-2 encrypted
# staging; set only with the matching client and migrated 0056 schema.
VAULTAI_ZK_LEGACY_FILE_EXTRA_STAGE_ENABLED=false
# Version 3 permits one proof-bound extra-field export up to 256 KiB UTF-8,
# followed by a <=2 MiB MVK-encrypted manifest. Requires schema 0061 and
# the exact-readback V3 client. V2 remains capped at 64 KiB.
VAULTAI_ZK_LEGACY_FILE_EXTRA_V3_ENABLED=false
VAULTAI_ZK_LEGACY_ITEM_RETIRE_ENABLED=false
VAULTAI_ZK_LEGACY_FILE_RETIRE_ENABLED=false
VAULTAI_ZK_LEGACY_FILE_EXTRA_RETIRE_ENABLED=false

# ---- Verified Assets (review gate; disabled by default) ----
# Verified Assets: closed PAX Gold/KMS Labs KAG Ethereum tuples, 18 decimals.
# Enable only after reviewing RPC/indexer readiness; existing cryptocurrency flags
# still gate receive/send. No new trading, fiat or custodial service is introduced.
VAULTAI_ASSETS_PAXG_ENABLED=false
# KAG requires reviewed issuer eligibility terms and live token+registry code,
# implementation, pause and address-access checks. Not native Kinesis KAG.
VAULTAI_ASSETS_KAG_ENABLED=false

# ---- Concierge exposure checks (review gate; disabled by default) ----
# Free is the budget-safe default: client-only Pwned Passwords checks require no
# subscription/key. Email/background/stealer checks are deferred even if a paid
# key or their enable flags are present. Unknown modes fail closed.
VAULTAI_CONCIERGE_PROVIDER_MODE=free
# A future explicitly reviewed mode=hibp requires a real HIBP subscription for
# email APIs. Range search needs IncludesKAnon. No free email adapter is enabled.
# Stealer-log email search additionally needs IncludesStealerLogs AND a provider-
# verified email domain. Never claim arbitrary Gmail/Yahoo or full dark-web coverage.
VAULTAI_CONCIERGE_ENABLED=false
VAULTAI_CONCIERGE_BACKGROUND_ENABLED=false
VAULTAI_CONCIERGE_STEALER_LOGS_ENABLED=false
CONCIERGE_HIBP_API_KEY=
VAULTAI_CONCIERGE_HIBP_RPM=5
VAULTAI_CONCIERGE_POLL_SECONDS=86400
# Dedicated server operational key, NOT a vault key; 32 random bytes, base64url
# without padding. Provision from the secret store; never copy from a vault PIN.
# Background email/results are operator-decryptable solely after explicit consent.
CONCIERGE_MONITORING_KEY=
# Optional reviewed key rotation: use a JSON object of key-id -> base64url key;
# keep old keys while their encrypted monitor rows remain. Rewrap occurs together
# on successful checks, never delete old keys before all rows are rewrapped.
CONCIERGE_MONITORING_KEYRING_JSON={}
CONCIERGE_MONITORING_ACTIVE_KEY_ID=v1
