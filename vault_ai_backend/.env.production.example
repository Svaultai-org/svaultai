# VaultAI backend — example environment file for PRODUCTION.
#
# Every value here is a placeholder. Copy to a secret store (Doppler,
# 1Password, AWS Secrets Manager, etc.) and inject at deploy time.
# Never commit real production secrets.
#
# In production, missing required config is a HARD BOOT ERROR — the
# app refuses to start rather than run insecurely.
#
# Dev-oriented example lives at `.env.example`.

# ---- Core -----------------------------------------------------
# MUST be `production` (or `prod`/`live`) in production.
VAULTAI_ENV=production

# Postgres connection string. Use a pooler and enforce SSL.
DATABASE_URL=

# 48-byte URL-safe base64 secret used to HMAC session tokens.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ROTATION invalidates every issued session.
VAULT_SESSION_SECRET=

# LLM provider. Rotate via the secret store, never in this file.
OPENAI_API_KEY=

# Descope project id.
DESCOPE_PROJECT_ID=


# ---- Production hardening flags -------------------------------
# MUST be `false` (or unset) in prod. `true` refuses to boot.
VAULTAI_DEBUG_ENDPOINTS_ENABLED=false

# MUST be `false` in prod. The dev auto-trust shortcut is an
# emergency lever only, not a production knob.
VAULTAI_DEVICE_GATE_DEV_AUTO_TRUST=false

VAULTAI_EXPERIMENTAL_VAULT_BRAIN_CHAT_ENABLED=false


# ---- CORS / origins -------------------------------------------
# REQUIRED in production. Anchor with ^$ and enumerate every
# legitimate frontend origin. Refuses to boot without this set.
#
# svaultai.com production plan:
#   https://app.svaultai.com   — user-facing web app
#   https://www.svaultai.com   — marketing site
#   https://svaultai.com       — apex, redirects to www
CORS_ALLOWED_ORIGIN_REGEX=^https://(app|www)\.svaultai\.com$|^https://svaultai\.com$

# Comma-separated exact origins used for safe redirect construction.
VAULTAI_ALLOWED_REDIRECT_ORIGINS=https://app.svaultai.com,https://www.svaultai.com,https://svaultai.com

FRONTEND_BASE_URL=https://app.svaultai.com
ALLOWED_ORIGINS=https://app.svaultai.com,https://www.svaultai.com,https://svaultai.com


# ---- Rate limiting --------------------------------------------
RATE_LIMIT_ENABLED=true

# In prod, run the Redis backend so per-node counters cluster.
VAULTAI_RATE_LIMIT_BACKEND=redis
VAULTAI_RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_URL=

# Per-bucket quotas. Blank = code defaults. Tune in the secret
# store once the production baseline is known.
VAULTAI_RL_PIN_VERIFY_LIMIT=
VAULTAI_RL_CHAT_LIMIT=
VAULTAI_RL_DELETE_VAULT_LIMIT=
VAULTAI_RL_UPLOAD_BURST_LIMIT=
VAULTAI_RL_DELETE_BURST_LIMIT=
VAULTAI_RL_EXPORT_LIMIT=


# ---- Security headers -----------------------------------------
# MUST be true in prod. Adds CSP, HSTS, X-Content-Type-Options,
# Referrer-Policy, Permissions-Policy, and no-store on sensitive
# routes.
VAULTAI_SECURITY_HEADERS_ENABLED=true


# ---- Upload / body limits -------------------------------------
# Blank = the defaults baked into main.py. Only override for
# targeted production tuning.
MAX_JSON_BODY_BYTES=
MAX_UPLOAD_BYTES=


# ---- File scan / mass-action guardrails -----------------------
FILE_SCAN_ENABLED=true
FILE_SCAN_PROVIDER=
MASS_ACTION_PROTECTION_ENABLED=true


# ---- Inactive unpaid cleanup ----------------------------------
# ON in prod. Deletes unpaid vaults inactive past the threshold.
INACTIVE_UNPAID_DELETE_ENABLED=true
INACTIVE_UNPAID_DELETE_DAYS=183


# ---- Billing providers ----------------------------------------
# Active Stripe checkout is retired. These legacy placeholders exist only
# when historic signed webhook processing is intentionally retained.
STRIPE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STORAGE_BLOCK_PRICE_ID=
STRIPE_PRODUCT_ID=
STRIPE_CHECKOUT_SUCCESS_URL=https://app.svaultai.com/storage?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=https://app.svaultai.com/storage?checkout=cancel
STRIPE_PORTAL_RETURN_URL=https://app.svaultai.com/storage

# Google Play Billing. Hostinger calls the narrow Cloud Run bridge over HTTPS;
# Cloud Run uses its attached service account through keyless ADC. This shared
# HMAC value comes from each platform's secret store and must be 32+ characters.
# Never set GOOGLE_APPLICATION_CREDENTIALS or create a service-account key.
VAULTAI_GOOGLE_PLAY_BRIDGE_URL=
VAULTAI_GOOGLE_PLAY_BRIDGE_HMAC_SECRET=
VAULTAI_GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=svaultai-play-billing@svaultai-production.iam.gserviceaccount.com
VAULTAI_GOOGLE_PLAY_PACKAGE_NAME=com.svaultai.app
VAULTAI_GOOGLE_PLAY_RTDN_AUDIENCE=https://api.svaultai.com/billing/google-play/rtdn
VAULTAI_GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=svaultai-play-rtdn-push@svaultai-production.iam.gserviceaccount.com
VAULTAI_GOOGLE_PLAY_ALLOW_TEST_PURCHASES=false

# Apple shared backend. Configure only after real App Store Connect IDs exist.
VAULTAI_APPLE_BUNDLE_ID=
VAULTAI_APPLE_APP_ID=
VAULTAI_APPLE_ROOT_CERT_DIR=
VAULTAI_APPLE_PRODUCT_MAP_JSON=
VAULTAI_APPLE_ACCEPT_SANDBOX=false

# Web checkout is fail-closed until an accurately disclosed merchant account
# is explicitly approved and an adapter is configured.
VAULTAI_WEB_CARD_PROVIDER=disabled


# ---- Crypto Wallet Engine -------------------------------------
VAULTAI_CRYPTO_WALLET_ENGINE_ENABLED=true
VAULTAI_CRYPTO_DEFAULT_NETWORK=ethereum_mainnet

# Ethereum mainnet. RPC URL + indexer API key from secret store.
VAULTAI_CRYPTO_ETH_MAINNET_RECEIVE_ENABLED=true
VAULTAI_CRYPTO_ETH_MAINNET_ERC20_RECEIVE_ENABLED=true
# Mainnet is the production-intended read/receive network. Broadcasting
# remains fail-closed until a separate operator-controlled launch decision.
VAULTAI_CRYPTO_ETH_MAINNET_SEND_ENABLED=false
VAULTAI_CRYPTO_MAINNET_SEND_PAUSED=true
ETHEREUM_MAINNET_RPC_URL=
# Public constants — safe to include.
ETHEREUM_MAINNET_USDT_CONTRACT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7
ETHEREUM_MAINNET_USDC_CONTRACT_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
ETHEREUM_MAINNET_TX_INDEXER_PROVIDER=etherscan
ETHEREUM_MAINNET_TX_INDEXER_API_KEY=

# Solana mainnet.
VAULTAI_CRYPTO_SOLANA_ENABLED=true
VAULTAI_CRYPTO_SOLANA_SEND_ENABLED=true
VAULTAI_CRYPTO_SOLANA_SEND_PAUSED=false
SOLANA_RPC_URL=
SOLANA_TX_INDEXER_PROVIDER=helius
SOLANA_TX_INDEXER_API_KEY=

# TRON mainnet.
VAULTAI_CRYPTO_TRON_ENABLED=true
VAULTAI_CRYPTO_TRON_SEND_ENABLED=true
VAULTAI_CRYPTO_TRON_SEND_PAUSED=false
TRON_API_BASE_URL=
TRON_API_KEY=
# Public constants — safe to include.
TRON_USDT_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_USDT_DECIMALS=6

# Monero. Scanner + send OFF at production launch until we ship
# the resident scanner and audited send path.
VAULTAI_CRYPTO_XMR_ENABLED=false
VAULTAI_CRYPTO_XMR_SEND_ENABLED=false
VAULTAI_CRYPTO_XMR_SCANNER_MODE=none


# ---- Admin health tokens --------------------------------------
# Random 256-bit tokens gate the ops-only health endpoints.
# Placeholder only — inject the real tokens from the secret store.
VAULTAI_CRYPTO_HEALTH_ADMIN_TOKEN=
VAULTAI_BILLING_HEALTH_ADMIN_TOKEN=

# ---- ZK v2 migration infrastructure --------------------------
# Production-safe defaults. Enabling requires a separately reviewed rollout.
ZK_V2_READ_ENABLED=true
ZK_V2_WRITE_ENABLED=false
ZK_V2_MIGRATION_ENABLED=false

MEMORY_V2_READ_ENABLED=true
MEMORY_V2_WRITE_ENABLED=true
MEMORY_V2_MIGRATION_ENABLED=false

FILE_V2_READ_ENABLED=true
FILE_V2_WRITE_ENABLED=true
FILE_V2_MIGRATION_ENABLED=false

WALLET_BACKUP_V2_READ_ENABLED=false
WALLET_BACKUP_V2_WRITE_ENABLED=false
WALLET_BACKUP_V2_MIGRATION_ENABLED=false

WALLET_V2_READ_ENABLED=false
WALLET_V2_WRITE_ENABLED=false
WALLET_V2_MIGRATION_ENABLED=false

PRIVATE_VAULT_LOCAL_ROUTING_ENABLED=false
