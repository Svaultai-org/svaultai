# VaultAI backend — example environment file for LOCAL DEVELOPMENT.
#
# Copy to `.env` and fill in the values you need. Never commit `.env`.
#
# Sensitive values (RPC URLs, API keys, admin tokens, session secrets)
# are intentionally LEFT BLANK. Fill them locally; do not paste
# production credentials here.
#
# Public constants (USDT/USDC contract addresses, USDT decimals,
# ticker names) are safe to include verbatim.
#
# Production-shaped example lives at `.env.production.example`.

# ---- Core -----------------------------------------------------
# Set to `development`, `dev`, `local`, `test`, or `ci` for local dev.
# Setting to `production`/`prod`/`live` enables production hardening
# and refuses to boot without the required prod-only config.
VAULTAI_ENV=development

# Postgres URL. Local dev usually points at a scratch Supabase pooler
# or `postgres://localhost:5432/vaultai_dev`.
DATABASE_URL=

# 48-byte URL-safe base64 secret used to HMAC session tokens.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
VAULT_SESSION_SECRET=

# LLM provider. Blank in the example — paste locally, never commit.
OPENAI_API_KEY=

# Descope auth project id (public-ish, but treat as blank in examples).
DESCOPE_PROJECT_ID=


# ---- Environment flags ----------------------------------------
# In dev, keep debug endpoints OFF unless you actively need them.
VAULTAI_DEBUG_ENDPOINTS_ENABLED=false

# Dev-only convenience: auto-trust the first device on a fresh vault
# so the local email-loop can be skipped. MUST be false in prod.
VAULTAI_DEVICE_GATE_DEV_AUTO_TRUST=false

# Vault Brain semantic chat. Off by default in dev.
VAULTAI_EXPERIMENTAL_VAULT_BRAIN_CHAT_ENABLED=false


# ---- CORS / origins -------------------------------------------
# Regex that must match every legitimate frontend origin. In dev,
# leaving this blank lets the resolver fall back to the loopback
# pattern (localhost/127.0.0.1/etc. on any port).
CORS_ALLOWED_ORIGIN_REGEX=

# Comma-separated exact origins the app treats as safe redirect
# destinations post-checkout/etc.
VAULTAI_ALLOWED_REDIRECT_ORIGINS=

# Public URL of the Flutter web frontend.
FRONTEND_BASE_URL=http://localhost:5173

# Comma-separated allowlist consulted by some routes when
# constructing outbound redirects.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ---- Rate limiting --------------------------------------------
RATE_LIMIT_ENABLED=true

# Backend selector: blank = in-memory (dev default);
# `redis` requires VAULTAI_RATE_LIMIT_REDIS_URL below.
VAULTAI_RATE_LIMIT_BACKEND=

# Redis connection string when the redis backend is on.
VAULTAI_RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_URL=

# Per-bucket quotas. Blank = code defaults from rate_limit_sensitive.
VAULTAI_RL_PIN_VERIFY_LIMIT=
VAULTAI_RL_CHAT_LIMIT=
VAULTAI_RL_DELETE_VAULT_LIMIT=
VAULTAI_RL_UPLOAD_BURST_LIMIT=
VAULTAI_RL_DELETE_BURST_LIMIT=
VAULTAI_RL_EXPORT_LIMIT=


# ---- Security headers -----------------------------------------
# Leave enabled unless you're actively debugging CSP locally.
VAULTAI_SECURITY_HEADERS_ENABLED=true


# ---- Upload / body limits -------------------------------------
# Blank = the defaults baked into main.py. Override only for
# targeted load testing.
MAX_JSON_BODY_BYTES=
MAX_UPLOAD_BYTES=


# ---- File scan / mass-action guardrails -----------------------
# Off by default in dev; provider is a stub until we wire ClamAV.
FILE_SCAN_ENABLED=false
FILE_SCAN_PROVIDER=

# Guards against bulk-delete / bulk-download storms.
MASS_ACTION_PROTECTION_ENABLED=true


# ---- Inactive unpaid cleanup ----------------------------------
# The background job that auto-deletes unpaid vaults inactive
# past the threshold. Off in dev so tests don't wipe fixtures.
INACTIVE_UNPAID_DELETE_ENABLED=false
INACTIVE_UNPAID_DELETE_DAYS=183


# ---- Stripe (test-mode only in this file) ---------------------
# All secrets left blank. Paste your local test-mode keys.
STRIPE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STORAGE_BLOCK_PRICE_ID=
STRIPE_PRODUCT_ID=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/storage?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/storage?checkout=cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/storage


# ---- Crypto Wallet Engine -------------------------------------
VAULTAI_CRYPTO_WALLET_ENGINE_ENABLED=true
VAULTAI_CRYPTO_DEFAULT_NETWORK=ethereum_mainnet

# Ethereum mainnet. RPC/indexer URLs and API keys stay blank.
VAULTAI_CRYPTO_ETH_MAINNET_RECEIVE_ENABLED=true
VAULTAI_CRYPTO_ETH_MAINNET_ERC20_RECEIVE_ENABLED=true
VAULTAI_CRYPTO_ETH_MAINNET_SEND_ENABLED=true
VAULTAI_CRYPTO_MAINNET_SEND_PAUSED=false
ETHEREUM_MAINNET_RPC_URL=
# Public constant — safe to include.
ETHEREUM_MAINNET_USDT_CONTRACT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7
ETHEREUM_MAINNET_USDC_CONTRACT_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
ETHEREUM_MAINNET_TX_INDEXER_PROVIDER=etherscan
ETHEREUM_MAINNET_TX_INDEXER_API_KEY=

# Solana mainnet. RPC URL + indexer API key stay blank.
VAULTAI_CRYPTO_SOLANA_ENABLED=true
VAULTAI_CRYPTO_SOLANA_SEND_ENABLED=true
VAULTAI_CRYPTO_SOLANA_SEND_PAUSED=false
SOLANA_RPC_URL=
SOLANA_TX_INDEXER_PROVIDER=helius
SOLANA_TX_INDEXER_API_KEY=

# TRON mainnet. Base URL + API key stay blank.
VAULTAI_CRYPTO_TRON_ENABLED=true
VAULTAI_CRYPTO_TRON_SEND_ENABLED=true
VAULTAI_CRYPTO_TRON_SEND_PAUSED=false
TRON_API_BASE_URL=
TRON_API_KEY=
# Public constants — safe to include.
TRON_USDT_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_USDT_DECIMALS=6

# Monero. Scanner must stay `none`, send stays off unless we ship it.
VAULTAI_CRYPTO_XMR_ENABLED=false
VAULTAI_CRYPTO_XMR_SEND_ENABLED=false
VAULTAI_CRYPTO_XMR_SCANNER_MODE=none


# ---- Admin health tokens --------------------------------------
# Random tokens gate the ops-only health endpoints. Blank in the
# example.
VAULTAI_CRYPTO_HEALTH_ADMIN_TOKEN=
VAULTAI_BILLING_HEALTH_ADMIN_TOKEN=

# ---- Production web v2 contract ------------------------------
# These values match scripts/build-web-release.*. Credential-v2 remains
# read-only on the local web path; generated credentials use the reviewed
# backend draft workflow. Memory-v2 and File-v2 are client-encrypted writes.
ZK_V2_READ_ENABLED=true
ZK_V2_WRITE_ENABLED=false
ZK_V2_MIGRATION_ENABLED=false
MEMORY_V2_READ_ENABLED=true
MEMORY_V2_WRITE_ENABLED=true
MEMORY_V2_MIGRATION_ENABLED=false
FILE_V2_READ_ENABLED=true
FILE_V2_WRITE_ENABLED=true
FILE_V2_MIGRATION_ENABLED=false
PRIVATE_VAULT_LOCAL_ROUTING_ENABLED=false
